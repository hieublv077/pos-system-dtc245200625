      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(container_memory_usage_bytes{name=~\"pos.*\"}) by (name) / 1024 / 1024",
          "legendFormat": "{{name}}"
