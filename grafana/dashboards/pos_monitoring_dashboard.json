      "title": "Tần Suất HTTP Request POS (req/s)",
      "type": "timeseries",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "Prometheus" },
          "expr": "sum(rate(pos_http_requests_total[1m])) by (endpoint)",
